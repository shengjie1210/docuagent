<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.business_assistant.mapper.DocumentMapper">

    <resultMap id="DocumentMap" type="com.example.business_assistant.bean.Document">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="filename" column="filename"/>
        <result property="fileType" column="file_type"/>
        <result property="filePath" column="file_path"/>
        <result property="size" column="size"/>
        <result property="summary" column="summary"/>
        <result property="tags" column="tags"/>
        <result property="chunkCount" column="chunk_count"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="cols">
        id, user_id, filename, file_type, file_path, size, summary, tags, chunk_count, status, created_at
    </sql>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.example.business_assistant.bean.Document"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO document (user_id, filename, file_type, file_path, size, status, created_at)
        VALUES (#{userId}, #{filename}, #{fileType}, #{filePath}, #{size}, #{status}, NOW())
    </insert>

    <!-- 按 ID + 用户查 -->
    <select id="selectByIdAndUserId" resultMap="DocumentMap">
        SELECT <include refid="cols"/>
        FROM document
        WHERE id = #{id} AND user_id = #{userId}
    </select>

    <!-- 分页列表 -->
    <select id="selectPage" resultMap="DocumentMap">
        SELECT <include refid="cols"/>
        FROM document
        WHERE user_id = #{userId}
        <if test="keyword != null and keyword != ''">
            AND filename LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 总数 -->
    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM document
        WHERE user_id = #{userId}
        <if test="keyword != null and keyword != ''">
            AND filename LIKE CONCAT('%', #{keyword}, '%')
        </if>
    </select>

    <!-- 删除 -->
    <delete id="deleteByIdAndUserId">
        DELETE FROM document
        WHERE id = #{id} AND user_id = #{userId}
    </delete>

    <!-- 回写索引结果（切分块数 + 状态 + AI 摘要） -->
    <update id="updateIndexResult">
        UPDATE document
        SET chunk_count = #{chunkCount},
            status = #{status}
            <if test="summary != null">, summary = #{summary}</if>
        WHERE id = #{id}
    </update>

    <!-- 管理员统计 -->
    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM document
    </select>

    <select id="sumChunkCount" resultType="long">
        SELECT COALESCE(SUM(chunk_count), 0) FROM document
    </select>
</mapper>
